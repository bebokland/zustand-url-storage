{
	"name": "@bebokland/zustand-url-storage",
	"version": "1.0.0",
	"type": "module",
	"description": "The custom storage adapter for Zustand's persist middleware that stores state directly in the browser URL (query string or hash).",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"./dist"
	],
	"scripts": {
		"build": "tsc",
		"check": "biome check --write ./src",
		"clean": "rm -rf dist",
		"test": "vitest run"
	},
	"keywords": [
		"zustand",
		"url storage",
		"custom storage",
		"persist middleware"
	],
	"author": "Artur Siaznik",
	"license": "ISC",
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	},
	"peerDependencies": {
		"zustand": "^5.0.12"
	},
	"packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"
}
